+# ---------------------------------------------------------- plan-state helpers
+# They read what --plan wrote; none of them knows how the engine decides.
+ul_t_state() { # -> the engine's state directory of the customer repo
+  printf '%s/loom/update' "$(git -C "$W_CUST" rev-parse --absolute-git-dir)"
+}
+
+ul_t_plan_row() { # PATH -> the whole plan.tsv row (nothing when there is none)
+  awk -F'\t' -v p="$1" '$1 == p { print; exit }' "$(ul_t_state)/plan.tsv" 2>/dev/null
+}
+
+ul_t_plan_col() { # PATH N -> column N of the path's plan.tsv row
+  awk -F'\t' -v p="$1" -v n="$2" '$1 == p { print $n; exit }' "$(ul_t_state)/plan.tsv" 2>/dev/null
+}
+
+ul_t_plan_class() { ul_t_plan_col "$1" 2; }     # PATH
+ul_t_plan_proposed() { ul_t_plan_col "$1" 3; }  # PATH
+ul_t_plan_detail() { ul_t_plan_col "$1" 4; }    # PATH
+
+ul_t_edit() { # REPO PATH CONTENT [MSG] : write CONTENT plus a newline to PATH, commit everything
+  mkdir -p "$(dirname -- "$1/$2")" || return 1
+  printf '%s\n' "$3" > "$1/$2" || return 1
+  ul_t_commit "$1" "${4:-edit $2}" >/dev/null
+}
