+# --------------------------------------------------------------- plan helpers
+ul_t_state() { git -C "$W_CUST" rev-parse --absolute-git-dir | awk '{ print $0 "/loom/update" }'; }
+
+ul_t_plan_field() { # PATH COLUMN-NUMBER
+  awk -F '\t' -v p="$1" -v n="$2" '$1 == p { print $n; exit }' "$(ul_t_state)/plan.tsv"
+}
