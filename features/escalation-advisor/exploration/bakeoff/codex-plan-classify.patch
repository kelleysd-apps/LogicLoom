+ul_t_plan_class() { ul_t_plan_field "$1" 2; }
+
+ul_t_edit() { # REPO PATH CONTENT COMMIT-SUBJECT
+  ul_te_repo=$1; ul_te_path=$2; ul_te_body=$3; ul_te_msg=$4
+  mkdir -p "$ul_te_repo/$(dirname "$ul_te_path")" || return 1
+  printf '%s\n' "$ul_te_body" > "$ul_te_repo/$ul_te_path" || return 1
+  ul_t_commit "$ul_te_repo" "$ul_te_msg"
