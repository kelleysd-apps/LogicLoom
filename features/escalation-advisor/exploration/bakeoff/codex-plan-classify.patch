+# ---------------------------------------------------------- plan classifier
+tree_mode() { # COMMIT PATH -> git tree mode, or nothing when absent
+  git -C "$root" ls-tree "$1" -- "$2" 2>/dev/null | awk '{ print $1; exit }'
+}
+
+local_path_for() { # UPSTREAM-PATH -> the corresponding path in HEAD/base
+  lpf_p=$1
+  if [ "$CHANNEL" = adopted ]; then
+    lpf_r=$(path_rename "$lpf_p")
+    if [ -n "$lpf_r" ]; then printf '%s' "$lpf_r"; return 0; fi
+  fi
+  printf '%s' "$lpf_p"
+}
+
+group_installed() { # GROUP -> true for a receipt's installed payload group
+  [ "$CH_GROUPS" = all ] && return 0
+  gi_old_ifs=$IFS
+  IFS=,
+  for gi_g in $CH_GROUPS; do
+    if [ "$gi_g" = "$1" ]; then IFS=$gi_old_ifs; return 0; fi
+  done
+  IFS=$gi_old_ifs
+  return 1
+}
+
+path_is_upstream_owned() {
+  case $1 in "$UL_NOTES_DIR"/*|"$UL_SCRIPTS_DIR"/*) return 0;; esac
+  return 1
+}
+
+path_plan_ignored() { # PATH -- updater-owned trees override the customer's ignores
+  path_is_upstream_owned "$1" && return 1
+  git -C "$root" check-ignore -q --no-index -- "$1" 2>/dev/null
+}
+
+plan_abort() { # REASON
+  printf 'result=aborted reason=%s unchanged=yes\n' "$1"
+  return 1
+}
+
+write_row() { # PATH CLASS PROPOSED DETAIL
+  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$state/plan.tsv"
+}
+
+save_plan_side() { # COMMIT PATH DEST; a literal dash records absence
+  sps_c=$1; sps_p=$2; sps_d=$3
+  mkdir -p "$(dirname -- "$sps_d")" || return 1
+  if [ -n "$sps_c" ] && [ -n "$(blob_sha "$sps_c" "$sps_p")" ]; then
+    git -C "$root" show "$sps_c:$sps_p" > "$sps_d" 2>/dev/null || return 1
+  else
+    printf '%s\n' - > "$sps_d"
+  fi
+}
+
+write_reviewer_log() { # OUTPUT-PATH UPSTREAM-PATH
+  wrl_d=$state/reviewer/$(dirname -- "$1")
+  mkdir -p "$wrl_d" || return 1
+  git -C "$root" log --format='%h %s' "$basecommit..$uh" -- "$2" > "$state/reviewer/$1.log" 2>/dev/null || :
+}
+
+write_plan_artifacts() { # uses the PP_* side coordinates set by process_path
+  wpa_p=$1
+  mkdir -p "$state/adapt/base/$(dirname -- "$wpa_p")" \
+    "$state/adapt/theirs/$(dirname -- "$wpa_p")" \
+    "$state/adapt/mine/$(dirname -- "$wpa_p")" \
+    "$state/diffs/$(dirname -- "$wpa_p")" || return 1
+  save_plan_side "$PP_BASE_COMMIT" "$PP_BASE_PATH" "$state/adapt/base/$wpa_p" || return 1
+  save_plan_side "$uh" "$PP_UP_PATH" "$state/adapt/theirs/$wpa_p" || return 1
+  save_plan_side HEAD "$PP_LOCAL_PATH" "$state/adapt/mine/$wpa_p" || return 1
+  wpa_b=${PP_BSHA:--}; wpa_u=${PP_USHA:--}; wpa_h=${PP_HSHA:--}
+  printf '%s\t-\t%s\t%s\t%s\n' "$wpa_p" "$wpa_b" "$wpa_u" "$wpa_h" >> "$state/adapt.tsv"
+  git diff --no-index -- "$state/adapt/base/$wpa_p" "$state/adapt/theirs/$wpa_p" > "$state/diffs/$wpa_p.base-upstream.diff" 2>/dev/null || :
+  git diff --no-index -- "$state/adapt/base/$wpa_p" "$state/adapt/mine/$wpa_p" > "$state/diffs/$wpa_p.base-local.diff" 2>/dev/null || :
+}
+
+write_classified_row() { # PATH CLASS PROPOSED DETAIL UPSTREAM-PATH
+  write_row "$1" "$2" "$3" "$4"
+  if [ "$3" != skip ]; then write_reviewer_log "$1" "$5" || return 1; fi
+  if [ "$3" = hold ] || [ "$2" = merged-clean ]; then
+    write_plan_artifacts "$1" || return 1
+  fi
+}
+
+try_merge_file() { # OUTPUT-PATH
+  tm_p=$1
+  tm_b=$(ul_mktemp) || exit 1
+  tm_h=$(ul_mktemp) || exit 1
+  tm_u=$(ul_mktemp) || exit 1
+  tm_o=$(ul_mktemp) || exit 1
+  git -C "$root" show "$PP_BASE_COMMIT:$PP_BASE_PATH" > "$tm_b" 2>/dev/null || return 1
+  git -C "$root" show "HEAD:$PP_LOCAL_PATH" > "$tm_h" 2>/dev/null || return 1
+  git -C "$root" show "$uh:$PP_UP_PATH" > "$tm_u" 2>/dev/null || return 1
+  if git merge-file -p "$tm_h" "$tm_b" "$tm_u" > "$tm_o" 2>/dev/null; then
+    mkdir -p "$state/merged/$(dirname -- "$tm_p")" || return 1
+    cp "$tm_o" "$state/merged/$tm_p" || return 1
+    write_classified_row "$tm_p" merged-clean apply "three-way merge was clean" "$PP_UP_PATH"
+  else
+    write_classified_row "$tm_p" conflict hold "three-way merge left conflict markers" "$PP_UP_PATH"
+  fi
+}
+
+sides_differ() { # COMMIT-A PATH-A COMMIT-B PATH-B (normalised content and mode)
+  sd_ah=$(norm_hash "$1" "$2"); sd_bh=$(norm_hash "$3" "$4")
+  sd_am=$(tree_mode "$1" "$2"); sd_bm=$(tree_mode "$3" "$4")
+  [ "$sd_ah" != "$sd_bh" ] || [ "$sd_am" != "$sd_bm" ]
+}
+
+process_path() { # UPSTREAM-PATH (also used for paths present on only one local side)
+  PP_UP_PATH=$1
+  [ "$PP_UP_PATH" = "$UL_SYNC_REF" ] && return 0
+  PP_LOCAL_PATH=$(local_path_for "$PP_UP_PATH")
+  PP_BASE_COMMIT=$basecommit
+  PP_BASE_PATH=$PP_LOCAL_PATH
+
+  # Paths that the engine may never write are still surfaced when upstream and the
+  # customer differ, so a user can see the boundary doing work.
+  if ul_path_forbidden "$PP_LOCAL_PATH"; then
+    sides_differ HEAD "$PP_LOCAL_PATH" "$uh" "$PP_UP_PATH" || return 0
+    write_row "$PP_LOCAL_PATH" excluded skip forbidden
+    return 0
+  fi
+  path_plan_ignored "$PP_UP_PATH" && return 0
+
+  if [ "$CHANNEL" = adopted ]; then
+    if path_adopt_excluded "$PP_UP_PATH"; then
+      sides_differ HEAD "$PP_LOCAL_PATH" "$uh" "$PP_UP_PATH" || return 0
+      write_row "$PP_LOCAL_PATH" excluded skip adopt-excluded
+      return 0
+    fi
+    # Merge rows are special installer-owned seams and need not also appear as a
+    # harness prefix. Every other adopted path is constrained by the prefix/group map.
+    if ! path_is_merge "$PP_UP_PATH"; then
+      pp_g=$(path_harness_group "$PP_UP_PATH")
+      if [ -z "$pp_g" ] && [ "$PP_LOCAL_PATH" != "$PP_UP_PATH" ]; then
+        pp_g=$(path_harness_group "$PP_LOCAL_PATH")
+      fi
+      if [ -z "$pp_g" ]; then
+        sides_differ HEAD "$PP_LOCAL_PATH" "$uh" "$PP_UP_PATH" || return 0
+        write_row "$PP_LOCAL_PATH" adopter-owned skip "not harness-owned"
+        return 0
+      fi
+      if [ "$CH_GROUPS" != all ] && ! group_installed "$pp_g"; then
+        sides_differ HEAD "$PP_LOCAL_PATH" "$uh" "$PP_UP_PATH" || return 0
+        write_row "$PP_LOCAL_PATH" adopter-owned skip "group $pp_g not installed"
+        return 0
+      fi
+    fi
+  fi
+
+  PP_BSHA=$(blob_sha "$PP_BASE_COMMIT" "$PP_BASE_PATH")
+  PP_HSHA=$(blob_sha HEAD "$PP_LOCAL_PATH")
+  PP_USHA=$(blob_sha "$uh" "$PP_UP_PATH")
+  pp_bn=$(norm_hash "$PP_BASE_COMMIT" "$PP_BASE_PATH")
+  pp_hn=$(norm_hash HEAD "$PP_LOCAL_PATH")
+  pp_un=$(norm_hash "$uh" "$PP_UP_PATH")
+  pp_bm=$(tree_mode "$PP_BASE_COMMIT" "$PP_BASE_PATH")
+  pp_hm=$(tree_mode HEAD "$PP_LOCAL_PATH")
+  pp_um=$(tree_mode "$uh" "$PP_UP_PATH")
+
+  if path_is_upstream_owned "$PP_UP_PATH"; then
+    [ "$pp_hn" != "$pp_un" ] || [ "$pp_hm" != "$pp_um" ] || return 0
+    if [ -z "$PP_USHA" ]; then
+      write_classified_row "$PP_LOCAL_PATH" delete apply upstream-owned "$PP_UP_PATH"
+    elif [ -z "$PP_HSHA" ]; then
+      write_classified_row "$PP_LOCAL_PATH" add apply upstream-owned "$PP_UP_PATH"
+    else
+      write_classified_row "$PP_LOCAL_PATH" take apply upstream-owned "$PP_UP_PATH"
+    fi
+    return 0
+  fi
+
+  # Adopted merge paths are held whenever local and upstream differ. settings.json
+  # uses the installer's recorded insertion as its honest base side when available.
+  if [ "$CHANNEL" = adopted ] && path_is_merge "$PP_UP_PATH"; then
+    [ "$pp_hn" != "$pp_un" ] || [ "$pp_hm" != "$pp_um" ] || return 0
+    if [ "$PP_UP_PATH" = .claude/settings.json ] && git -C "$root" cat-file -e "HEAD:.claude/.logicloom-adopt-settings.json" 2>/dev/null; then
+      PP_BASE_COMMIT=HEAD
+      PP_BASE_PATH=.claude/.logicloom-adopt-settings.json
+      PP_BSHA=$(blob_sha "$PP_BASE_COMMIT" "$PP_BASE_PATH")
+      pp_detail="adopted merge path; base_side=adopt-settings"
+    else
+      PP_BASE_COMMIT=
+      PP_BASE_PATH=
+      PP_BSHA=
+      pp_detail="adopted merge path; base_side=-"
+    fi
+    write_classified_row "$PP_LOCAL_PATH" posture hold "$pp_detail" "$PP_UP_PATH"
+    return 0
+  fi
+
+  if [ -z "$PP_BSHA" ]; then
+    if [ -n "$PP_USHA" ] && [ -z "$PP_HSHA" ]; then
+      write_classified_row "$PP_LOCAL_PATH" add apply "new upstream file" "$PP_UP_PATH"
+    elif [ -n "$PP_USHA" ] && [ -n "$PP_HSHA" ]; then
+      if [ "$pp_hn" = "$pp_un" ] && [ "$pp_hm" = "$pp_um" ]; then return 0; fi
+      write_classified_row "$PP_LOCAL_PATH" add-conflict hold "new upstream file, and a different local file already exists" "$PP_UP_PATH"
+    fi
+    return 0
+  fi
+
+  # Identical resulting sides need no work, including matching deletions/mode flips.
+  if [ "$pp_hn" = "$pp_un" ] && [ "$pp_hm" = "$pp_um" ]; then return 0; fi
+
+  pp_lc=1
+  if [ "$pp_hn" = "$pp_bn" ] && [ "$pp_hm" = "$pp_bm" ]; then pp_lc=0; fi
+  pp_uc=1
+  if [ "$pp_un" = "$pp_bn" ] && [ "$pp_um" = "$pp_bm" ]; then pp_uc=0; fi
+
+  # Same bytes with a mode-only divergence is explicit in the plan.
+  if [ -n "$PP_HSHA" ] && [ -n "$PP_USHA" ] && [ "$pp_hn" = "$pp_bn" ] && [ "$pp_un" = "$pp_bn" ]; then
+    if [ "$pp_lc" = 0 ] && [ "$pp_uc" = 1 ]; then
+      write_classified_row "$PP_LOCAL_PATH" mode apply "upstream mode changed" "$PP_UP_PATH"
+    elif [ "$pp_lc" = 1 ] && [ "$pp_uc" = 0 ]; then
+      write_classified_row "$PP_LOCAL_PATH" keep keep "changed locally only" "$PP_UP_PATH"
+    else
+      write_classified_row "$PP_LOCAL_PATH" mode hold "mode changed differently on both sides" "$PP_UP_PATH"
+    fi
+    return 0
+  fi
+
+  if [ "$pp_uc" = 1 ] && [ "$pp_lc" = 0 ]; then
+    if [ -z "$PP_USHA" ]; then
+      write_classified_row "$PP_LOCAL_PATH" delete apply "deleted upstream, unchanged locally" "$PP_UP_PATH"
+    else
+      write_classified_row "$PP_LOCAL_PATH" take apply "changed upstream, unchanged locally" "$PP_UP_PATH"
+    fi
+    return 0
+  fi
+  if [ "$pp_lc" = 1 ] && [ "$pp_uc" = 0 ]; then
+    write_classified_row "$PP_LOCAL_PATH" keep keep "changed locally only" "$PP_UP_PATH"
+    return 0
+  fi
+
+  if [ -z "$PP_USHA" ]; then
+    write_classified_row "$PP_LOCAL_PATH" deleted-upstream-kept hold "deleted upstream, changed locally" "$PP_UP_PATH"
+  elif [ -z "$PP_HSHA" ]; then
+    write_classified_row "$PP_LOCAL_PATH" conflict hold "deleted locally, changed upstream" "$PP_UP_PATH"
+  elif ul_path_posture "$PP_LOCAL_PATH" || [ "$PP_LOCAL_PATH" = .claude/settings.json ]; then
+    write_classified_row "$PP_LOCAL_PATH" posture hold "posture file changed on both sides" "$PP_UP_PATH"
+  else
+    try_merge_file "$PP_LOCAL_PATH"
+  fi
+}
+
+write_two_way_row() { # PATH -- hook used by the notes layer in the next package
+  tw_p=$1
+  PP_UP_PATH=$tw_p
+  PP_LOCAL_PATH=$(local_path_for "$tw_p")
+  PP_BASE_COMMIT=
+  PP_BASE_PATH=
+  PP_BSHA=
+  PP_HSHA=$(blob_sha HEAD "$PP_LOCAL_PATH")
+  PP_USHA=$(blob_sha "$uh" "$PP_UP_PATH")
+  write_classified_row "$PP_LOCAL_PATH" two-way hold "two-way comparison requested by update note" "$PP_UP_PATH"
+}
+
+select_plan_base() {
+  BASE_RUNG=
+  BASE_SHA=
+  sp_rec=$(recorded_stamp)
+  sp_full=$(reach_full "$sp_rec") || sp_full=
+  if [ -n "$sp_full" ] && [ "$(ledger_row_count)" = 0 ]; then
+    sp_tag=$(git -C "$root" for-each-ref --sort=-refname --sort=-creatordate --format='%(refname)' 'refs/tags/loom/pre-update-*' 2>/dev/null | sed -n '1p')
+    if [ -n "$sp_tag" ] && git -C "$root" merge-base --is-ancestor "$sp_tag" HEAD 2>/dev/null; then
+      sp_old=$(git -C "$root" show "$sp_tag:$UL_SYNC_REF" 2>/dev/null | tr -d ' \t\r\n')
+      if sp_oldfull=$(reach_full "$sp_old") && [ "$sp_oldfull" != "$sp_full" ]; then
+        BASE_RUNG=handover; BASE_SHA=$sp_oldfull
+      fi
+    fi
+  fi
+  if [ -z "$BASE_RUNG" ] && [ -n "$sp_full" ]; then BASE_RUNG=recorded; BASE_SHA=$sp_full; fi
+  if [ -z "$BASE_RUNG" ] && [ -n "$sp_rec" ]; then
+    sp_map=$(remap_known_bad "$sp_rec")
+    if [ -n "$sp_map" ] && sp_mapfull=$(reach_full "$sp_map"); then BASE_RUNG=remap; BASE_SHA=$sp_mapfull; fi
+  fi
+  if [ -z "$BASE_RUNG" ] && closest_search; then
+    printf 'closest %s %s\n' "$CL_SHA" "$CL_N"
+    plan_abort "base unconfirmed; run --set-base $CL_SHA"
+    return 1
+  fi
+  if [ -z "$BASE_RUNG" ]; then
+    plan_abort "base could not be detected; see KNOWN_ISSUES.md or run npx logicloom@7 update-bootstrap"
+    return 1
+  fi
+  return 0
+}
+
 # =============================================================== subcommands
 cmd_status() {
   if heal_stale; then :; fi
@@ -1068,6 +1356,92 @@ cmd_bootstrap_copy() {
   return 0
 }
 
+cmd_plan() {
+  resolve_channel
+  cp_off=$(clean_offenders)
+  if status_failed "$cp_off"; then plan_abort "could not read the working tree state (git status failed)"; return 1; fi
+  if [ -n "$cp_off" ]; then
+    cp_one=$(printf '%s\n' "$cp_off" | tr '\n' ',' | sed 's/,$//')
+    plan_abort "working tree has uncommitted changes: $cp_one"
+    return 1
+  fi
+  if in_progress; then plan_abort "a merge, rebase, cherry-pick or revert is in progress"; return 1; fi
+  if is_shallow; then plan_abort "run git fetch --unshallow first"; return 1; fi
+  if [ "$CH" = ambiguous ] && [ -z "$OPT_CHANNEL" ]; then
+    plan_abort "channel is ambiguous; rerun with --channel template or --channel adopted"
+    return 1
+  fi
+  if ! heal_stale; then plan_abort "stage.lock is held by live pid $LOCK_LIVE"; return 1; fi
+  if [ -f "$state/staged" ]; then plan_abort "a staged update exists; run --finish or --abandon"; return 1; fi
+
+  if ! fetch_upstream; then echo "error $FETCH_ERROR"; return 1; fi
+  UPSTREAM_HEAD=$(upstream_head) || UPSTREAM_HEAD=
+  if [ -z "$UPSTREAM_HEAD" ]; then echo "error upstream has no main branch"; return 1; fi
+  channel_map_load
+  if ! select_plan_base; then return 1; fi
+  basecommit=$BASE_SHA
+  uh=$UPSTREAM_HEAD
+  cp_head=$(git -C "$root" rev-parse HEAD) || return 1
+
+  if [ -d "$state/export" ]; then chmod -R u+w "$state/export" 2>/dev/null || :; fi
+  rm -rf "$state"
+  mkdir -p "$state/diffs" "$state/merged" "$state/adapt/base" "$state/adapt/theirs" \
+    "$state/adapt/mine" "$state/reviewer" "$state/export" "$state/tools" || return 1
+  : > "$state/plan.tsv"
+  : > "$state/adapt.tsv"
+
+  cp_tools=absent
+  cp_tool_ok=1
+  for cp_tool in json-valid.sh json-flat.sh; do
+    if git -C "$root" show "$uh:$UL_SCRIPTS_DIR/$cp_tool" > "$state/tools/$cp_tool" 2>/dev/null; then
+      chmod 644 "$state/tools/$cp_tool" || return 1
+    else
+      rm -f "$state/tools/$cp_tool"
+      cp_tool_ok=0
+    fi
+  done
+  [ "$cp_tool_ok" = 1 ] && cp_tools=saved
+
+  if ! git -C "$root" archive HEAD | tar -x -C "$state/export"; then
+    echo "error could not export HEAD"
+    return 1
+  fi
+  chmod -R a-w "$state/export" || return 1
+
+  cp_stamp=$(date -u +%Y%m%dT%H%M%SZ)
+  cp_short=$(printf '%.12s' "$uh")
+  cp_id=$cp_stamp-$cp_short
+  {
+    printf 'base=%s\n' "$basecommit"
+    printf 'base_rung=%s\n' "$BASE_RUNG"
+    printf 'upstream=%s\n' "$uh"
+    printf 'head=%s\n' "$cp_head"
+    printf 'channel=%s\n' "$CHANNEL"
+    printf 'update_id=%s\n' "$cp_id"
+    printf 'time=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  } > "$state/meta"
+
+  cp_paths=$(ul_mktemp) || exit 1
+  {
+    git -C "$root" ls-tree -r --name-only "$basecommit" 2>/dev/null
+    git -C "$root" ls-tree -r --name-only HEAD 2>/dev/null
+    git -C "$root" ls-tree -r --name-only "$uh" 2>/dev/null
+  } | sort -u > "$cp_paths"
+  while IFS= read -r cp_p; do
+    [ -n "$cp_p" ] || continue
+    process_path "$cp_p" || return 1
+  done < "$cp_paths"
+
+  printf 'tools=%s\n' "$cp_tools"
+  awk -F '\t' '{ n[$2]++ } END { for (k in n) print "class." k "=" n[k] }' "$state/plan.tsv" | sort
+  cp_rows=$(awk 'END { print NR + 0 }' "$state/plan.tsv")
+  cp_action=$(awk -F '\t' '$2 != "keep" && $2 != "excluded" && $2 != "adopter-owned" { n++ } END { print n + 0 }' "$state/plan.tsv")
+  printf 'rows=%s\n' "$cp_rows"
+  printf 'plan=%s\n' "$state/plan.tsv"
+  [ "$cp_action" -eq 0 ] && printf 'uptodate=yes\n'
+  return 0
+}
