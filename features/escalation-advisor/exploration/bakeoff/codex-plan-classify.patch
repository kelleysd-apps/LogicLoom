 }
 
+cmd_selftest_two_way() { # PATH
+  [ -n "${1:-}" ] || { echo "error --selftest-two-way needs a path"; exit 2; }
+  [ -f "$state/meta" ] || { echo "error run --plan first"; exit 1; }
+  basecommit=$(sed -n 's/^base=//p' "$state/meta")
+  uh=$(sed -n 's/^upstream=//p' "$state/meta")
+  CHANNEL=$(sed -n 's/^channel=//p' "$state/meta")
+  detect_channel
+  write_two_way_row "$1" || exit 1
+  printf 'two_way=%s\n' "$1"
+}
+
