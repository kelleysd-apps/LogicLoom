.local/
*.local

# Structured Logging (ignore log files, keep structure)
.logic-loom/logs/operations/*.log
.logic-loom/logs/git-checkpoints/*.json
.logic-loom/logs/parallel-sessions/*
!.logic-loom/logs/README.md

# Context System Cache
.claude/context/.cache/*
# Session-specific audit logs (generated at runtime)
.docs/governance/audit/

# Session-specific agent data (generated at runtime)
.docs/agents/**/decisions/*.json
.docs/agents/**/sessions/*.json
.docs/agents/**/reports/*.json
.docs/agents/shared/context-summaries/*.json
.docs/agents/audit/creation-log.json

# Research output (session-specific)
.docs/research/

# Dev-loop runtime data
.devloop/

# Backup files from edits
*.bak
.claude/skill-index.json.bak

# RL metrics (session-specific, regenerated)
# Keep the template but ignore session data
# .docs/rl-metrics/skill-performance.json  # Keep for now as template

# Feature specs are TRACKED (downstream products commit their specs;
# the framework's own dev specs are stripped at template release by
# sanitize-for-template.sh)

# Deprecated items (kept locally for reference, not in template)
**/.deprecated/

# Backlog index (DERIVED from backlog.md / features/*/plan.md / specs/*/tasks.md
# by .logic-loom/scripts/bash/build-backlog-index.sh). Deliberately UNTRACKED: a
# tracked derived artifact goes stale the moment a source is edited without
# regenerating, and this repo has been bitten by that class three times.
# Regenerate on demand; never commit. (tests/contract/test_backlog_index.sh
# asserts this ignore rule is still in force.)
.logic-loom/backlog-index.json

# Backlog dashboard (DERIVED from backlog-index.json by
# .logic-loom/scripts/bash/build-backlog-dashboard.sh). Untracked for the SAME
# reason as the index above, and one step more so: a `file://` page cannot
# fetch() a sibling JSON, so the generator INLINES a snapshot of the index into
# the HTML. That snapshot is frozen at generation time — tracking it would ship
# a page that silently disagrees with both the index and the sources. Regenerate
# on demand; never commit. (tests/contract/test_backlog_dashboard.sh asserts
# this ignore rule is still in force.)
.logic-loom/backlog-dashboard.html

# Memory search index (generated, regenerable)
.loom-memory-index/
.sdd-memory-index/
vector_helper.py

# Memory working tier (session-specific)
plugins/loom-memory/working/
!plugins/loom-memory/working/.gitkeep
plugins/loom-memory/recall/
!plugins/loom-memory/recall/.gitkeep
plugins/loom-memory/.retention-last-run

# Memory runtime logs (generated)
.docs/memory/search-log.jsonl

# Test artifacts
test-checkpoint-*

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.egg-info/
.loom-worktree-env

# Local git worktrees (machine-specific; would be committed as a gitlink)
.claude/worktrees/
