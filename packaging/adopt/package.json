{
  "name": "logicloom",
  "version": "0.0.0-dev",
  "description": "LogicLoom — governed multi-agent harness for Claude Code. `logicloom init` plans its installation into a repository, and applies only what you name.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelleysd-apps/LogicLoom.git",
    "directory": "packaging/adopt"
  },
  "bin": {
    "logicloom": "bin/logicloom.js"
  },
  "main": "lib/plan.js",
  "files": [
    "bin/",
    "lib/",
    "merge/",
    "payload/",
    "payload-manifest.txt",
    "PLAN-FORMAT.md",
    "AGENT-INSTALL.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {},
  "scripts": {
    "init": "node bin/logicloom.js init"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "keywords": [
    "logicloom",
    "claude-code",
    "agent-harness",
    "governance"
  ]
}
