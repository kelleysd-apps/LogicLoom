{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/worktree-port-namespace.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash plugins/loom-governance/hooks/scripts/git-safety-gate.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/guard-dangerous-commands.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Bash(git push --force:*)"],
    "allow": ["Bash(git status:*)"],
    "ask": ["Bash(git restore:*)"]
  }
}
