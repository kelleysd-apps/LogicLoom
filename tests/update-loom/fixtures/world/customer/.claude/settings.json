{
  "enabledPlugins": {
    "fixture@local": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/worktree-port-namespace.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash plugins/loom-governance/hooks/scripts/git-safety-gate.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/guard-prod-db.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Bash(git push --force:*)", "Bash(rm -rf:*)"],
    "allow": ["Bash(git status:*)"],
    "ask": []
  }
}
