{
  "enabledPlugins": { "fixture@local": true },
  "statusLine": { "type": "command", "command": "echo hi" },
  "hooks": {
    "SessionStart": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "bash .claude/hooks/worktree-port-namespace.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "bash plugins/loom-governance/hooks/scripts/git-safety-gate.sh" },
        { "type": "command", "command": "bash .claude/hooks/old-hook.sh" }
      ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash scripts/hooks/guard-prod-db.sh" } ] },
      { "matcher": "mcp__.*", "hooks": [ { "type": "command", "command": "bash scripts/hooks/guard-prod-db.sh" } ] }
    ]
  },
  "permissions": {
    "deny": ["Bash(git push --force:*)", "Bash(sudo:*)"],
    "allow": ["Bash(git status:*)"],
    "ask": ["Bash(git push:*)", "Bash(git reset:*)"]
  }
}
